{
  "version": 4,
  "project": {
    "kind": "library",
    "capabilities": []
  },
  "scope": {
    "entryPoints": ["src/index.ts"],
    "development": ["tests/**"]
  },
  "quality": {
    "allowComments": false
  },
  "portability": {},
  "modules": [
    {
      "name": "layout-adapter",
      "paths": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "pnpm-workspace.yaml",
        ".node-version"
      ]
    }
  ],
  "checks": [
    {
      "name": "source-package",
      "provides": ["build"],
      "modules": ["layout-adapter"],
      "argv": ["pnpm", "build"],
      "runOn": ["build"],
      "timeoutSeconds": 120
    }
  ],
  "tests": {
    "ownership": [
      {
        "paths": ["tests/**"],
        "module": "layout-adapter",
        "focusedSuite": "layout-reconciliation",
        "executionSuite": "layout-reconciliation"
      }
    ],
    "suites": [
      {
        "name": "layout-reconciliation",
        "kind": "unit",
        "scope": "module",
        "modules": ["layout-adapter"],
        "argv": ["pnpm", "test"],
        "runOn": ["focused", "recommended", "full"],
        "cost": "quick",
        "timeoutSeconds": 120,
        "paths": ["tests/**"]
      },
      {
        "name": "layout-package-full",
        "kind": "unit",
        "scope": "repository",
        "argv": ["pnpm", "test"],
        "runOn": ["full"],
        "cost": "quick",
        "paths": ["tests/**"],
        "timeoutSeconds": 120
      }
    ]
  },
  "supplyChain": {
    "allowedDependencyProtocols": [],
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "MIT",
      "MPL-2.0"
    ],
    "releaseArtifacts": [
      {
        "name": "node",
        "versionFile": ".node-version",
        "source": "node-runtime"
      }
    ]
  },
  "exceptions": [],
  "documentation": {
    "design": [
      {
        "path": "docs/design/layout-adapter.md",
        "module": "layout-adapter"
      }
    ]
  }
}
